FROM node:20-alpine AS base

WORKDIR /app

RUN npm install -g pnpm@10.11.1

# Install build tools for native dependencies
RUN apk add --no-cache libc6-compat python3 make g++

# Copy root workspace configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/backend/package.json ./apps/backend/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy backend source code
COPY apps/backend ./apps/backend

WORKDIR /app/apps/backend

ENV NODE_ENV=production

# Build Medusa Server bundle first (.medusa/server)
RUN NODE_OPTIONS="--max-old-space-size=2048" npx medusa build --no-lint

# Build Medusa Admin dashboard bundle second (.medusa/admin/index.html)
RUN NODE_OPTIONS="--max-old-space-size=2048" npx medusa build --admin-only --no-lint

# Verify both server and admin builds exist in image
RUN ls -la .medusa && ls -la .medusa/admin && test -f .medusa/admin/index.html

# Set runtime memory limit for 512MB container
ENV NODE_OPTIONS="--max-old-space-size=450"
EXPOSE 9000
ENV PORT=9000

# Start server (migration + start)
CMD ["sh", "-c", "npx medusa db:migrate && npx medusa start"]
