STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
# Base URL of the storefront, used in password-reset e-mail links
STOREFRONT_URL=http://localhost:8000

# Uploaded files are stored in S3 only; the backend won't start without these.
# Product images go to the public media bucket, customers' documents to the
# locked documents bucket. These are the development buckets; live uses its
# own pair. See docs/PRIVATE_DOCUMENTS.md.
S3_REGION=ap-south-1
S3_MEDIA_BUCKET=ingredientsbazar-media-dev
S3_MEDIA_URL=https://ingredientsbazar-media-dev.s3.ap-south-1.amazonaws.com
S3_DOCUMENTS_BUCKET=ingredientsbazar-documents-dev
# AWS credentials are not set here. On a developer's machine they come from
# `aws login`; on a server, from its role or AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY.
